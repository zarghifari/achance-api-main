    {
      "name": "Cache Performance Tests",
      "item": [
        {
          "name": "Cold Cache - First Request",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Clear any cached ETag",
                  "pm.environment.unset('cachedETag');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cold cache request successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const coldResponseTime = pm.response.responseTime;",
                  "pm.environment.set('coldResponseTime', coldResponseTime);",
                  "",
                  "console.log('❄️ Cold cache response time: ' + coldResponseTime + 'ms');",
                  "",
                  "if (pm.response.headers.has('ETag')) {",
                  "    pm.environment.set('cachedETag', pm.response.headers.get('ETag'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses?timestamp={{$timestamp}}",
              "host": ["{{baseUrl}}"],
              "path": ["courses"],
              "query": [
                {
                  "key": "timestamp",
                  "value": "{{$timestamp}}",
                  "description": "Prevent caching"
                }
              ]
            }
          }
        },
        {
          "name": "Warm Cache - Second Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Warm cache request successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const warmResponseTime = pm.response.responseTime;",
                  "const coldResponseTime = pm.environment.get('coldResponseTime');",
                  "",
                  "pm.test('Warm cache is faster than cold cache', function () {",
                  "    pm.expect(warmResponseTime).to.be.below(coldResponseTime);",
                  "});",
                  "",
                  "const improvement = ((coldResponseTime - warmResponseTime) / coldResponseTime * 100).toFixed(2);",
                  "",
                  "console.log('🔥 Warm cache response time: ' + warmResponseTime + 'ms');",
                  "console.log('📈 Performance improvement: ' + improvement + '%');",
                  "",
                  "pm.test('Cache improvement is at least 20%', function () {",
                  "    pm.expect(parseFloat(improvement)).to.be.at.least(20);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        }
      ]
    },

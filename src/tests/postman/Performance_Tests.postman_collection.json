{
  "info": {
    "name": "API Performance & Optimization Tests",
    "description": "Tests for verifying HTTP/2, ETag caching, database indexes, and overall performance improvements",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Set base URL if not already set",
          "if (!pm.environment.get('baseUrl')) {",
          "    pm.environment.set('baseUrl', 'http://localhost/api');",
          "}",
          "",
          "// Record start time for performance measurement",
          "pm.environment.set('requestStartTime', Date.now());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Calculate response time",
          "const startTime = pm.environment.get('requestStartTime');",
          "const responseTime = Date.now() - startTime;",
          "pm.environment.set('responseTime', responseTime);",
          "",
          "// Log response time",
          "console.log('Response Time: ' + responseTime + 'ms');",
          "",
          "// Check for performance headers",
          "if (pm.response.headers.has('ETag')) {",
          "    console.log('ETag: ' + pm.response.headers.get('ETag'));",
          "}",
          "if (pm.response.headers.has('X-Cache-Status')) {",
          "    console.log('Cache Status: ' + pm.response.headers.get('X-Cache-Status'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as Teacher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has token', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.environment.set('authToken', jsonData.token);",
                  "    pm.environment.set('userId', jsonData.user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"teacher@example.com\",\n    \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "ETag Caching Tests",
      "item": [
        {
          "name": "1. First Request - Get Courses (No ETag)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has ETag header', function () {",
                  "    pm.response.to.have.header('ETag');",
                  "    const etag = pm.response.headers.get('ETag');",
                  "    pm.environment.set('testETag', etag);",
                  "    console.log('Stored ETag: ' + etag);",
                  "});",
                  "",
                  "pm.test('Response has data', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "    console.log('First request time: ' + pm.response.responseTime + 'ms');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        },
        {
          "name": "2. Second Request - With ETag (Should Return 304)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Note: Laravel might return 200 with cached response instead of 304",
                  "// This is implementation-dependent",
                  "pm.test('Status code is 200 or 304', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 304]);",
                  "});",
                  "",
                  "if (pm.response.code === 304) {",
                  "    pm.test('304 response has no body', function () {",
                  "        pm.expect(pm.response.text()).to.be.empty;",
                  "    });",
                  "    console.log('✅ ETag working - got 304 Not Modified');",
                  "} else if (pm.response.code === 200) {",
                  "    pm.test('Response has same ETag', function () {",
                  "        const newETag = pm.response.headers.get('ETag');",
                  "        const oldETag = pm.environment.get('testETag');",
                  "        pm.expect(newETag).to.equal(oldETag);",
                  "    });",
                  "    console.log('✅ ETag working - got cached response with same ETag');",
                  "}",
                  "",
                  "pm.test('Response time is faster than first request', function () {",
                  "    // Cached responses should be faster",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "    console.log('Cached request time: ' + pm.response.responseTime + 'ms');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "If-None-Match",
                "value": "{{testETag}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        },
        {
          "name": "3. Test ETag on Course Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has ETag header', function () {",
                  "    pm.response.to.have.header('ETag');",
                  "    const etag = pm.response.headers.get('ETag');",
                  "    pm.environment.set('courseDetailETag', etag);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.environment.set('testCourseId', jsonData.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        }
      ]
    },

#!/bin/bash

# PHP-FPM Health Check Script
set -e

# Check if PHP-FPM is running
if ! pgrep -f php-fpm > /dev/null; then
    echo "PHP-FPM process not found"
    exit 1
fi

# Check FPM status page
if command -v curl >/dev/null 2>&1; then
    response=$(curl -f -s http://localhost:9000/fpm-status 2>/dev/null || echo "failed")
    if [[ "$response" == "failed" ]]; then
        echo "PHP-FPM status check failed"
        exit 1
    fi
else
    # Alternative check using cgi-fcgi if curl not available
    if command -v cgi-fcgi >/dev/null 2>&1; then
        response=$(SCRIPT_NAME=/fpm-ping SCRIPT_FILENAME=/fpm-ping REQUEST_METHOD=GET cgi-fcgi -bind -connect localhost:9000 2>/dev/null || echo "failed")
        if [[ "$response" != *"pong"* ]]; then
            echo "PHP-FPM ping check failed"
            exit 1
        fi
    fi
fi

echo "PHP-FPM is healthy"
exit 0

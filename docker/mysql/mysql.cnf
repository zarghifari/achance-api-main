[mysql]
port                           = 3306
socket                         = /var/run/mysqld/mysqld.sock

[mysqld]
# Basic Settings
port                           = 3306
socket                         = /var/run/mysqld/mysqld.sock
pid-file                       = /var/run/mysqld/mysqld.pid
datadir                        = /var/lib/mysql
tmpdir                         = /tmp
skip-external-locking
skip-name-resolve              # Faster connections without DNS lookups

# Network Settings
bind-address                   = 0.0.0.0
max_connections                = 500  # Reduced for development
max_connect_errors             = 10000
back_log                       = 256
max_allowed_packet             = 64M  # Reduced for development

# Memory Settings (Optimized for development with 2GB limit)
key_buffer_size                = 256M
max_heap_table_size           = 128M
tmp_table_size                = 128M
sort_buffer_size              = 4M
join_buffer_size              = 4M
read_buffer_size              = 2M
read_rnd_buffer_size          = 2M

# InnoDB Settings (Critical for performance)
innodb_buffer_pool_size       = 1G  # Reduced for development
innodb_buffer_pool_instances  = 4
innodb_log_file_size          = 256M
innodb_log_buffer_size        = 32M
innodb_flush_log_at_trx_commit = 2  # Better performance (less durable)
innodb_flush_method           = O_DIRECT
innodb_file_per_table         = 1
innodb_open_files             = 400
innodb_io_capacity            = 400
innodb_io_capacity_max        = 2000
innodb_read_io_threads        = 4
innodb_write_io_threads       = 4
innodb_thread_concurrency     = 8
innodb_lock_wait_timeout      = 50
innodb_autoinc_lock_mode      = 2  # Faster auto-increment
innodb_stats_on_metadata      = 0  # Prevent metadata locks

# Query Cache - REMOVED in MySQL 8.0+
# MySQL 8.0 removed query cache, commenting out these variables
# query_cache_type              = 1
# query_cache_size              = 64M
# query_cache_limit             = 16M

# Thread Settings
thread_cache_size             = 100
thread_stack                  = 256K

# Table Settings
table_open_cache              = 2000
table_definition_cache        = 1000
open_files_limit              = 10000

# Logging (Minimal for development)
slow_query_log                = 1
slow_query_log_file           = /var/log/mysql/slow-query.log
long_query_time               = 1  # Log queries over 1 second
log_queries_not_using_indexes = 1
log_slow_admin_statements     = 1
general_log                   = 0  # Disable general log for performance

# Binary Logging (Disabled for development)
skip-log-bin                  # Disable binary logging for faster writes

# Security
local-infile                  = 0

# Character Set
character-set-server          = utf8mb4
collation-server              = utf8mb4_unicode_ci

# Timeout Settings
wait_timeout                  = 600  # 10 minutes
interactive_timeout           = 600
connect_timeout               = 10

# Performance Schema (Disabled for better performance in development)
performance_schema            = 0

[mysqldump]
quick
quote-names
max_allowed_packet            = 64M

[mysql]
default-character-set         = utf8mb4

[client]
default-character-set         = utf8mb4
port                         = 3306
socket                       = /var/run/mysqld/mysqld.sock
